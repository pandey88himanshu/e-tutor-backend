# Server Configuration
PORT=4000
NODE_ENV=development  # Set to "production" on Render

# Database
DATABASE_URL=your_database_url_here

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# JWT Tokens
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
APP_NAME=E-Tutor

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# For production: https://e-tutor-backend-aywc.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=/api/auth/google/callback

# Frontend URL - IMPORTANT for CORS and cookie settings
# For local development: http://localhost:3000
# For production (Render): https://e-tutor-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# Admin
ADMIN_CREATION_KEY=your_admin_creation_key
